@page "/einkaufsliste"
@rendermode InteractiveServer

<PageTitle>Einkaufsliste</PageTitle>

<div class="shopping-page">
    <div class="page-heading">
        <p class="eyebrow">Alltag einfach organisieren</p>
        <h1>🛒 Einkaufsliste</h1>
        <p class="intro">Verwalte deine Einkäufe und sammle Zutaten für deine Lieblingsgerichte.</p>
    </div>

    @if (!string.IsNullOrEmpty(speicherFehler))
    {
        <div class="validation-summary">@speicherFehler</div>
    }

    <div class="content-grid">
        <section class="card shopping-card">
            <div class="section-heading">
                <div>
                    <p class="eyebrow">Was brauchst du?</p>
                    <h2>Meine Einkaufsliste</h2>
                </div>
                <span class="item-count">@einkaufsliste.Count Artikel</span>
            </div>

            <EditForm Model="artikelEingabe" OnValidSubmit="ArtikelHinzufuegen">
                <DataAnnotationsValidator />
                <div class="form-grid">
                    <div class="field field-wide">
                        <label for="artikel-name">Artikel oder Gericht</label>
                        <input id="artikel-name" @bind="artikelEingabe.Name" list="gerichte-vorschlaege"
                               placeholder="z. B. Milch oder Pfannkuchen" />
                        <ValidationMessage For="@(() => artikelEingabe.Name)" />
                    </div>
                    <div class="field">
                        <label for="artikel-menge">Menge</label>
                        <input id="artikel-menge" @bind="artikelEingabe.Menge" type="number" min="0.01" step="0.01" />
                        <ValidationMessage For="@(() => artikelEingabe.Menge)" />
                    </div>
                    <div class="field">
                        <label for="artikel-einheit">Einheit</label>
                        <input id="artikel-einheit" @bind="artikelEingabe.Einheit" placeholder="z. B. Stück, kg" />
                        <ValidationMessage For="@(() => artikelEingabe.Einheit)" />
                    </div>
                    <div class="field field-wide">
                        <label for="artikel-notiz">Notiz <span>(optional)</span></label>
                        <input id="artikel-notiz" @bind="artikelEingabe.Notiz" placeholder="z. B. Vollmilch" />
                        <ValidationMessage For="@(() => artikelEingabe.Notiz)" />
                    </div>
                </div>
                <div class="form-actions">
                    <button type="submit">Hinzufügen</button>
                </div>
            </EditForm>
            <datalist id="gerichte-vorschlaege">
                @foreach (Gericht gericht in gerichte)
                {
                    <option value="@gericht.Name"></option>
                }
            </datalist>
            <p class="input-hint">Bei einem gespeicherten Gericht werden alle Zutaten automatisch übernommen.</p>

            @if (einkaufsliste.Count == 0)
            {
                <p class="empty-message">Noch keine Artikel vorhanden.</p>
            }
            else
            {
                <ul class="item-list">
                    @foreach (Artikel artikel in einkaufsliste)
                    {
                        <li class="list-item @(artikel.Erledigt ? "completed" : "")">
                            <label>
                                <input type="checkbox" @bind="artikel.Erledigt" @bind:after="() => ErledigtAendern(artikel)" />
                                <span>
                                    @artikel.Menge @artikel.Einheit @artikel.Name
                                    @if (!string.IsNullOrWhiteSpace(artikel.Notiz))
                                    {
                                        <small class="item-note">(@artikel.Notiz)</small>
                                    }
                                </span>
                            </label>
                            <button type="button" class="delete-button" @onclick="() => ArtikelLoeschen(artikel)">
                                Löschen
                            </button>
                        </li>
                    }
                </ul>
            }
        </section>

        <section class="card recipes-card">
            <div class="section-heading">
                <div>
                    <p class="eyebrow">Für später vorgemerkt</p>
                    <h2>🍝 Meine Gerichte</h2>
                </div>
                <span class="item-count">@gerichte.Count Gerichte</span>
            </div>

            <EditForm Model="gerichtEingabe" OnValidSubmit="GerichtHinzufuegen">
                <DataAnnotationsValidator />
                <div class="form-grid">
                    <div class="field">
                        <label for="gericht-name">Gerichtname</label>
                        <input id="gericht-name" @bind="gerichtEingabe.Name" placeholder="z. B. Pfannkuchen" />
                        <ValidationMessage For="@(() => gerichtEingabe.Name)" />
                    </div>
                    <div class="field">
                        <label for="gericht-kategorie">Kategorie</label>
                        <input id="gericht-kategorie" @bind="gerichtEingabe.Kategorie" placeholder="z. B. Hauptgericht" />
                        <ValidationMessage For="@(() => gerichtEingabe.Kategorie)" />
                    </div>
                    <div class="field">
                        <label for="gericht-zutat">Erste Zutat</label>
                        <input id="gericht-zutat" @bind="gerichtEingabe.Zutat" placeholder="z. B. Mehl" />
                        <ValidationMessage For="@(() => gerichtEingabe.Zutat)" />
                    </div>
                </div>
                <div class="form-actions">
                    <button type="submit">Gericht hinzufügen</button>
                </div>
            </EditForm>

            @if (gerichte.Count == 0)
            {
                <p class="empty-message">Noch keine Gerichte vorhanden.</p>
            }
            else
            {
                <div class="recipe-list">
                    @foreach (Gericht gericht in gerichte)
                    {
                        <article class="recipe">
                            <h3>@gericht.Name</h3>
                            <p class="recipe-category">@gericht.Kategorie?.Name</p>
                            <ul class="ingredient-list">
                                @foreach (GerichtZutat gz in gericht.GerichtZutaten)
                                {
                                    <li>
                                        @gz.Zutat?.Name
                                        <button type="button" class="delete-button"
                                                @onclick="() => ZutatEntfernen(gericht, gz)">Entfernen</button>
                                    </li>
                                }
                            </ul>
                            <EditForm Model="neueZutaten[gericht.Id]" OnValidSubmit="() => ZutatHinzufuegen(gericht)">
                                <DataAnnotationsValidator />
                                <div class="input-row ingredient-input">
                                    <div class="field">
                                        <label for="zutat-@gericht.Id">Weitere Zutat</label>
                                        <input id="zutat-@gericht.Id" @bind="neueZutaten[gericht.Id].Name" placeholder="Zutat eingeben" />
                                        <ValidationMessage For="@(() => neueZutaten[gericht.Id].Name)" />
                                    </div>
                                    <button type="submit">Zutat hinzufügen</button>
                                </div>
                            </EditForm>
                            <button type="button" class="delete-button" @onclick="() => GerichtLoeschen(gericht)">
                                Gericht löschen
                            </button>
                        </article>
                    }
                </div>
            }
        </section>
    </div>
</div>

@code {
    [Inject] private EinkaufslistenService EinkaufslistenService { get; set; } = default!;

    private List<Artikel> einkaufsliste = [];
    private List<Gericht> gerichte = [];
    private readonly Dictionary<int, ZutatEingabe> neueZutaten = [];
    private readonly Artikel artikelEingabe = new();
    private readonly GerichtEingabe gerichtEingabe = new();
    private string speicherFehler = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await Laden();
    }

    /// <summary>Liest den aktuellen Stand aus der Datenbank.</summary>
    private async Task Laden()
    {
        einkaufsliste = await EinkaufslistenService.GetArtikelAsync();
        gerichte = await EinkaufslistenService.GetGerichteAsync();

        foreach (Gericht gericht in gerichte)
        {
            if (!neueZutaten.ContainsKey(gericht.Id))
            {
                neueZutaten[gericht.Id] = new ZutatEingabe();
            }
        }
    }

    private async Task ArtikelHinzufuegen()
    {
        SpeicherErgebnis ergebnis = await EinkaufslistenService.ArtikelHinzufuegenAsync(
            artikelEingabe.Name,
            artikelEingabe.Menge,
            artikelEingabe.Einheit,
            artikelEingabe.Notiz);

        if (!ergebnis.Erfolg)
        {
            speicherFehler = ergebnis.Fehler ?? string.Empty;
            return;
        }

        artikelEingabe.Name = string.Empty;
        artikelEingabe.Menge = 1;
        artikelEingabe.Einheit = "Stück";
        artikelEingabe.Notiz = string.Empty;
        speicherFehler = string.Empty;
        await Laden();
    }

    private async Task ErledigtAendern(Artikel artikel)
    {
        await EinkaufslistenService.ErledigtSetzenAsync(artikel.Id, artikel.Erledigt);
    }

    private async Task ArtikelLoeschen(Artikel artikel)
    {
        await EinkaufslistenService.ArtikelLoeschenAsync(artikel.Id);
        await Laden();
    }

    private async Task GerichtHinzufuegen()
    {
        SpeicherErgebnis ergebnis = await EinkaufslistenService.GerichtAnlegenAsync(
            gerichtEingabe.Name,
            gerichtEingabe.Kategorie,
            gerichtEingabe.Zutat);

        if (!ergebnis.Erfolg)
        {
            speicherFehler = ergebnis.Fehler ?? string.Empty;
            return;
        }

        gerichtEingabe.Name = string.Empty;
        gerichtEingabe.Kategorie = string.Empty;
        gerichtEingabe.Zutat = string.Empty;
        speicherFehler = string.Empty;
        await Laden();
    }

    private async Task ZutatHinzufuegen(Gericht gericht)
    {
        ZutatEingabe eingabe = neueZutaten[gericht.Id];
        SpeicherErgebnis ergebnis = await EinkaufslistenService.ZutatHinzufuegenAsync(gericht.Id, eingabe.Name);

        if (!ergebnis.Erfolg)
        {
            speicherFehler = ergebnis.Fehler ?? string.Empty;
            return;
        }

        eingabe.Name = string.Empty;
        speicherFehler = string.Empty;
        await Laden();
    }

    private async Task ZutatEntfernen(Gericht gericht, GerichtZutat gz)
    {
        SpeicherErgebnis ergebnis = await EinkaufslistenService.ZutatEntfernenAsync(gericht.Id, gz.ZutatId);
        speicherFehler = ergebnis.Erfolg ? string.Empty : ergebnis.Fehler ?? string.Empty;
        await Laden();
    }

    private async Task GerichtLoeschen(Gericht gericht)
    {
        await EinkaufslistenService.GerichtLoeschenAsync(gericht.Id);
        neueZutaten.Remove(gericht.Id);
        speicherFehler = string.Empty;
        await Laden();
    }
}
